# Port for the backend server (default 3000)
PORT=3000

# Gmail SMTP (hellofocusframe26@gmail.com)
# Requires: 2-Step Verification enabled + App Password generated
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=hellofocusframe26@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Email sender display name
SENDER_NAME=FocusFrame

# Secret key for triggering /api/send-daily from cron-job.org
CRON_KEY=generate-a-random-secret-here

# Anthropic API key for Dasher AI assistant (get at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
