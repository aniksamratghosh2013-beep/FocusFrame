# Port for the backend server (default 3000)
PORT=3000

# Brevo API (email delivery) — get at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# Email sender display name
SENDER_NAME=FocusFrame

# Supabase (persistent subscriber database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Groq API key for Dasher AI assistant (optional — falls back to NLP.js)
GROQ_API_KEY=gsk_...

# Secret key for triggering /api/send-daily
CRON_KEY=generate-a-random-secret-here
